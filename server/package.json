{
  "name": "@collab/server",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run build --workspace @collab/shared",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "pretypecheck": "npm run build --workspace @collab/shared",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --experimental-strip-types src/test/run-tests.ts",
    "migrations:run": "tsx scripts/run-migrations.ts run",
    "migrations:status": "tsx scripts/run-migrations.ts status",
    "migrations:run:prod": "node dist/migrate.js run",
    "migrations:status:prod": "node dist/migrate.js status",
    "test:migrations": "tsx --test tests/migrations.test.ts"
  },
  "dependencies": {
    "@collab/shared": "*",
    "better-auth": "^1.4.13",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lib0": "^0.2.117",
    "pg": "^8.12.0",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.5.10",
    "eslint": "^8.57.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
