NODE_ENV=production
PORT=4000
API_HOST_PORT=4000

POSTGRES_DB=collabit
POSTGRES_USER=collabit
POSTGRES_PASSWORD=REPLACE_WITH_HEX_RANDOM_VALUE
DATABASE_URL=postgresql://collabit:REPLACE_WITH_HEX_RANDOM_VALUE@database:5432/collabit

AUTH_BASE_URL=https://api.example.com
CLIENT_BASE_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
TRUST_PROXY=true

JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
AUTH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

API_BODY_LIMIT=1mb
WS_MAX_PAYLOAD_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
SHUTDOWN_TIMEOUT_MS=10000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Collabit <no-reply@example.com>
